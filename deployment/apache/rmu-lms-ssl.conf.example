# Production TLS virtual hosts. Replace every LMS_DOMAIN before enabling.
<VirtualHost *:80>
    ServerName LMS_DOMAIN
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    ErrorLog ${APACHE_LOG_DIR}/rmu-lms-error.log
    CustomLog ${APACHE_LOG_DIR}/rmu-lms-access.log combined
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName LMS_DOMAIN

    SSLEngine On
    SSLCertificateFile /etc/letsencrypt/live/LMS_DOMAIN/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/LMS_DOMAIN/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    ProxyRequests Off
    ProxyPreserveHost On
    ProxyAddHeaders On
    ProxyTimeout 660
    # Apache's directive ceiling is below 2 GiB on some 2.4 builds. Leave it
    # unlimited here; the inner Nginx and Frappe both enforce the 2 GiB limit.
    LimitRequestBody 0

    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # Apache 2.4.47+ passes the WebSocket upgrade through mod_proxy_http.
    ProxyPass        /socket.io/ http://127.0.0.1:8080/socket.io/ upgrade=websocket connectiontimeout=5 timeout=660 retry=0
    ProxyPassReverse /socket.io/ http://127.0.0.1:8080/socket.io/

    ProxyPass        / http://127.0.0.1:8080/ connectiontimeout=5 timeout=660 retry=0
    ProxyPassReverse / http://127.0.0.1:8080/

    Header always set Strict-Transport-Security "max-age=31536000"

    ErrorLog ${APACHE_LOG_DIR}/rmu-lms-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/rmu-lms-ssl-access.log combined
</VirtualHost>
</IfModule>
