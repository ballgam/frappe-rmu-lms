# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
FROM ${PYTHON_IMAGE} AS base

ARG NODE_VERSION=22.22.0
ARG NODE_SHA256=9aa8e9d2298ab68c600bd6fb86a6c13bce11a4eca1ba9b39d79fa021755d7c37
ARG YARN_VERSION=1.22.22
ARG BENCH_VERSION=5.31.0
ARG WKHTMLTOPDF_VERSION=0.12.6.1-3
ARG WKHTMLTOPDF_SHA256=98ba0d157b50d36f23bd0dedf4c0aa28c7b0c50fcdcdc54aa5b6bbba81a3941d
ARG SHAKA_PACKAGER_VERSION=3.9.3
ARG SHAKA_PACKAGER_SHA256=7a3cf35ad146fd7810b4ededab363c8a3e6121d1b2c8391f53863126186f9ee6

ENV PATH="/opt/node/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FRAPPE_DOCKER_BUILD=1

RUN useradd --create-home --shell /bin/bash --uid 1000 frappe \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        ca-certificates \
        chromium \
        curl \
        ffmpeg \
        file \
        gettext-base \
        git \
        gpg \
        jq \
        less \
        libcairo2 \
        libffi8 \
        libfontconfig1 \
        libharfbuzz0b \
        libjpeg62-turbo \
        libldap-2.5-0 \
        liblcms2-2 \
        libmariadb3 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libpangoft2-1.0-0 \
        libpq5 \
        libsasl2-2 \
        libtiff6 \
        libwebp7 \
        libxml2 \
        libxslt1.1 \
        mariadb-client \
        media-types \
        nginx \
        procps \
        restic \
        tini \
        util-linux \
        wait-for-it \
        xz-utils \
        xfonts-75dpi \
        xfonts-base \
        xvfb \
    && curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && mkdir -p /opt/node \
    && tar --extract --xz --file=/tmp/node.tar.xz --strip-components=1 --directory=/opt/node \
    && npm install --global "yarn@${YARN_VERSION}" \
    && curl -fsSLo /tmp/wkhtmltox.deb "https://github.com/wkhtmltopdf/packaging/releases/download/${WKHTMLTOPDF_VERSION}/wkhtmltox_${WKHTMLTOPDF_VERSION}.bookworm_amd64.deb" \
    && echo "${WKHTMLTOPDF_SHA256}  /tmp/wkhtmltox.deb" | sha256sum --check --strict \
    && apt-get install --no-install-recommends -y /tmp/wkhtmltox.deb \
    && curl -fsSLo /usr/local/bin/packager "https://github.com/shaka-project/shaka-packager/releases/download/v${SHAKA_PACKAGER_VERSION}/packager-linux-x64" \
    && echo "${SHAKA_PACKAGER_SHA256}  /usr/local/bin/packager" | sha256sum --check --strict \
    && chmod 0755 /usr/local/bin/packager \
    && pip install --no-cache-dir "frappe-bench==${BENCH_VERSION}" \
    && rm -f /tmp/node.tar.xz /tmp/wkhtmltox.deb \
    && rm -rf /var/lib/apt/lists/* /root/.cache \
    && rm -f /etc/nginx/sites-enabled/default \
    && sed -i '/^user /d' /etc/nginx/nginx.conf \
    && mkdir -p /etc/nginx/snippets /templates/nginx \
    && touch /run/nginx.pid \
    && chown -R frappe:frappe \
        /etc/nginx/conf.d \
        /etc/nginx/nginx.conf \
        /etc/nginx/snippets \
        /home/frappe \
        /run/nginx.pid \
        /var/lib/nginx \
        /var/log/nginx

COPY deployment/docker/nginx-template.conf /templates/nginx/frappe.conf.template
COPY deployment/docker/security-headers.conf /etc/nginx/snippets/security_headers.conf
COPY deployment/docker/nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
COPY deployment/docker/main-entrypoint.sh /usr/local/bin/entrypoint.sh
COPY deployment/docker/start.sh /usr/local/bin/start.sh
COPY deployment/scripts/backup-container.sh /usr/local/sbin/rmu-lms-backup
COPY deployment/scripts/smoke-image.sh /usr/local/sbin/rmu-lms-smoke-image

RUN chmod 0755 \
        /usr/local/bin/entrypoint.sh \
        /usr/local/bin/nginx-entrypoint.sh \
        /usr/local/bin/start.sh \
        /usr/local/sbin/rmu-lms-backup \
        /usr/local/sbin/rmu-lms-smoke-image \
    && chmod 0644 /templates/nginx/frappe.conf.template /etc/nginx/snippets/security_headers.conf

FROM base AS builder

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        build-essential \
        cron \
        gcc \
        libcairo2-dev \
        libbz2-dev \
        libffi-dev \
        libgif-dev \
        libjpeg-dev \
        liblcms2-dev \
        libldap2-dev \
        libmariadb-dev \
        libpango1.0-dev \
        libpq-dev \
        librsvg2-dev \
        libsasl2-dev \
        libtiff-dev \
        libwebp-dev \
        libxml2-dev \
        libxslt1-dev \
        pkg-config \
        redis-tools \
        rlwrap \
        tk8.6-dev \
        wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/source
COPY --chown=frappe:frappe apps/frappe ./apps/frappe
COPY --chown=frappe:frappe apps/payments ./apps/payments
COPY --chown=frappe:frappe apps/lms ./apps/lms
COPY --chown=frappe:frappe sites/apps.txt ./sites/apps.txt

USER frappe
RUN set -eux; \
    for app in frappe payments lms; do \
        git -C "/opt/source/apps/${app}" init --initial-branch=container-build; \
        git -C "/opt/source/apps/${app}" config user.name "RMU LMS Builder"; \
        git -C "/opt/source/apps/${app}" config user.email "builder@invalid.local"; \
        git -C "/opt/source/apps/${app}" add --all; \
        git -C "/opt/source/apps/${app}" commit --quiet --message "Container build source"; \
    done \
    && printf 'frappe\n' > /opt/source/sites/apps.txt \
    && mkdir -p /home/frappe/apps-extra \
    && mv /opt/source/apps/payments /opt/source/apps/lms /home/frappe/apps-extra/ \
    && mkdir -p /home/frappe/frappe-bench \
    && cd /home/frappe/frappe-bench \
    && bench init . \
        --ignore-exist \
        --clone-from=/opt/source \
        --clone-without-update \
        --python=python3 \
        --no-procfile \
        --no-backups \
        --skip-assets \
        --skip-redis-config-generation \
    && cd /home/frappe/frappe-bench \
    && cp -R /home/frappe/apps-extra/payments /home/frappe/apps-extra/lms apps/ \
    && uv pip install \
        --python env/bin/python \
        -e apps/payments \
        -e apps/lms \
    && cd apps/lms \
    && yarn install --frozen-lockfile --non-interactive \
    && cd /home/frappe/frappe-bench \
    && printf 'frappe\npayments\nlms\n' > sites/apps.txt \
    && bench build --production \
    && printf '{}\n' > sites/common_site_config.json \
    && rm -rf apps/lms/node_modules apps/lms/frontend/node_modules \
    && find apps -mindepth 2 -type d -name .git -prune -exec rm -rf '{}' + \
    && find apps -type d \( -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache \) -prune -exec rm -rf '{}' +

FROM base AS runtime

ARG IMAGE_SOURCE="local-checkout"
ARG IMAGE_REVISION="unknown"
ARG IMAGE_VERSION="development"

LABEL org.opencontainers.image.title="RMU Somalia Frappe Learning" \
      org.opencontainers.image.description="RMU Somalia / UN customized Frappe Learning production image" \
      org.opencontainers.image.source="${IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench
RUN cp -a sites/assets /home/frappe/frappe-bench/assets \
    && rm -rf sites/assets \
    && install -d -o frappe -g frappe logs

VOLUME ["/home/frappe/frappe-bench/sites", "/home/frappe/frappe-bench/logs"]

USER frappe
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["/usr/local/bin/start.sh"]
