# Written by deploy.sh after building this checkout on the server.
LMS_IMAGE=rmu-lms:unbuilt

# The Frappe site name must exactly match the public DNS name.
SITE_NAME=learning.example.org
FRONTEND_BIND=127.0.0.1:8080

# Production Linux defaults. On macOS, deploy.sh replaces these with ignored
# deployment/local-data paths. Secret files are mode 0600 and never committed.
DB_ROOT_PASSWORD_FILE=/etc/rmu-lms/db-root-password
RESTIC_PASSWORD_FILE=/etc/rmu-lms/restic-password

# Encrypted local backups. macOS uses deployment/local-data/backups instead.
# Copy snapshots off this host separately for disaster recovery.
BACKUP_DIR=/var/backups/rmu-lms
RESTIC_REPOSITORY=/backup/restic
BACKUP_TAG=rmu-lms

# Upload and proxy limits. Keep CLIENT_MAX_BODY_SIZE aligned with site max_file_size.
CLIENT_MAX_BODY_SIZE=2g
PROXY_READ_TIMEOUT=660s

# Web concurrency. Two workers limit simultaneous in-memory 2 GB upload spikes.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180

# Docker subnet trusted by the inner Nginx proxy for X-Forwarded-For processing.
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12
