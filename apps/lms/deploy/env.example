# Production .env for the frappe_docker stack.
# Copy into the frappe_docker checkout as `.env` and fill in the marked values.
#
# Only the values that differ from frappe_docker's own example.env are listed,
# plus the ones you must set. Everything else can stay at its upstream default.

# --- image -------------------------------------------------------------------
CUSTOM_IMAGE=ghcr.io/rmu-somalia/lms
CUSTOM_TAG=v1
PULL_POLICY=always
# Unused once CUSTOM_TAG is set, but compose still interpolates it. Keep it
# defined to avoid a warning on every command.
ERPNEXT_VERSION=v15

# --- site + TLS --------------------------------------------------------------
SITES_RULE=Host(`learning.example.edu`)          # <-- set
LETSENCRYPT_EMAIL=admin@example.edu              # <-- set
DB_PASSWORD=                                     # <-- set, long and random

# --- client IPs behind Traefik -----------------------------------------------
# nginx does `set_real_ip_from ${UPSTREAM_REAL_IP_ADDRESS}`. Traefik sits in the
# compose network, so the peer address nginx sees is Traefik's container IP, not
# 127.0.0.1 — leave the upstream default and every request is attributed to
# Traefik, which breaks rate limiting and makes login audit logs useless.
# Widen it to the Docker bridge range.
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12

# --- video upload path -------------------------------------------------------
# These four defaults all break lecture uploads. Frappe's upload_file buffers
# the whole file in memory, so a 2 GB lecture is a 2 GB spike in one gunicorn
# worker and a slow upload holds that worker for its whole duration.
CLIENT_MAX_BODY_SIZE=2g      # upstream default 50m  -> 413 on any real lecture
PROXY_READ_TIMEOUT=3600      # upstream default 120  -> 504 mid-upload (seconds)
GUNICORN_TIMEOUT=3600        # upstream default 120  -> worker killed mid-upload

# Sized for an 8 GB box. Each worker can be holding a whole upload, so raising
# this without raising RAM is how the box gets OOM-killed. See the "Known
# limitations" section of deploy/README.md.
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
