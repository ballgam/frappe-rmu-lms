# Media layer for the LMS video pipeline.
#
# Adds the two external tools that lms/lms/video/ shells out to:
#
#   ffmpeg/ffprobe  - normalize and split streams (apt)
#   packager        - Shaka Packager, builds the DASH manifest (static binary)
#
# Shaka Packager ships no OS package, which is why lms/lms/video/pipeline.py
# defaults to running the official Docker image. That default needs a mounted
# /var/run/docker.sock, which is not something to hand a public web container.
# Installing the static binary here instead lets LMS Settings -> Video
# Processing -> Shaka Packager Mode be set to "Binary", and Docker drops out of
# the request path entirely.
#
# This is deliberately a thin layer FROM the frappe_docker custom image rather
# than a patch to images/custom/Containerfile, so upstream frappe_docker can be
# pulled and the base rebuilt without re-applying anything.
#
# Build:
#   docker build -t ghcr.io/rmu-somalia/lms:v1 \
#     --build-arg BASE_IMAGE=ghcr.io/rmu-somalia/lms-base:v1 \
#     -f deploy/Dockerfile.media deploy/

ARG BASE_IMAGE=ghcr.io/rmu-somalia/lms-base:v1
FROM ${BASE_IMAGE}

USER root

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# Pinned to a release verified as a static-pie stripped ELF with no dynamic
# dependencies, so it runs on the slim Debian base as-is.
# Bump all three together; the checksums are per-architecture.
ARG PACKAGER_VERSION=v3.9.3
ARG PACKAGER_SHA256_AMD64=7a3cf35ad146fd7810b4ededab363c8a3e6121d1b2c8391f53863126186f9ee6
ARG PACKAGER_SHA256_ARM64=d3a50cecc139b54435be1bbbfba5c0ea822d9e1e7edc3531f7821fba65ceebb0

# Set by BuildKit. Defaulted so a plain `docker build` on x86-64 still works.
ARG TARGETARCH=amd64

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) asset=packager-linux-x64;   sha="${PACKAGER_SHA256_AMD64}" ;; \
      arm64) asset=packager-linux-arm64; sha="${PACKAGER_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/packager \
      "https://github.com/shaka-project/shaka-packager/releases/download/${PACKAGER_VERSION}/${asset}"; \
    echo "${sha}  /usr/local/bin/packager" | sha256sum -c -; \
    chmod 755 /usr/local/bin/packager

# Fail the build here rather than on the first upload. `packager --version` is
# the same call pipeline.py makes in its preflight, so a green build means the
# preflight will pass too.
RUN set -eux; \
    ffmpeg  -version | head -1; \
    ffprobe -version | head -1; \
    packager --version

USER frappe
